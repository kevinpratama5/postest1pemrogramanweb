<script>
// ─────────────────────────────────────────────
// Navigation
// ─────────────────────────────────────────────
let currentSection = 'overview';

function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.style.display = 'none');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const sec = document.getElementById('sec-' + id);
  if (sec) { sec.style.display = 'block'; currentSection = id; }
  event && event.target && event.target.classList.add('active');
}

// ─────────────────────────────────────────────
// Logger helpers
// ─────────────────────────────────────────────
function log(logId, msg, cls) {
  const el = document.getElementById(logId);
  if (!el) return;
  const span = document.createElement('span');
  span.className = cls || 'll-d';
  span.textContent = '[' + new Date().toLocaleTimeString('en',{hour12:false}) + '] ' + msg;
  el.appendChild(span);
  el.appendChild(document.createElement('br'));
  el.scrollTop = el.scrollHeight;
}

function setResult(id, msg, type) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent = msg;
  el.className = 'result-banner ' + type;
  el.style.display = 'block';
}

function setChip(id, text, state) {
  const el = document.getElementById(id);
  if (el) { el.textContent = text; el.className = 'chip ' + state; }
}

// ─────────────────────────────────────────────
// Environment Checks
// ─────────────────────────────────────────────
function runAllChecks() {
  const logId = currentSection === 'env' ? 'env-log' : 'overview-log';
  const isHttps = location.protocol === 'https:' || location.hostname === 'localhost';

  log(logId, 'Origin: ' + location.origin, 'll-b');
  log(logId, 'Protocol: ' + location.protocol + (isHttps ? ' ✓ secure' : ' ✗ NOT secure (keyboard.lock / WebAuthn need HTTPS)'), isHttps ? 'll-g' : 'll-r');

  // WebAuthn
  const hasWA = !!(navigator.credentials && window.PublicKeyCredential);
  log(logId, 'WebAuthn: ' + (hasWA ? '✓ available' : '✗ not available'), hasWA ? 'll-g' : 'll-r');
  setChip('chip-v1-webauthn', 'WebAuthn: ' + (hasWA ? 'AVAILABLE' : 'N/A'), hasWA ? 'ok' : 'err');

  // HTTPS for WebAuthn
  document.getElementById('v1-https-val').textContent = isHttps ? '✓' : '✗ need HTTPS';
  setChip('chip-v1-https', 'HTTPS: ' + (isHttps ? 'YES ✓' : 'NO ✗'), isHttps ? 'ok' : 'err');

  // Digital Credentials
  const hasDC = !!(navigator.credentials && typeof navigator.credentials.get === 'function');
  log(logId, 'Credentials API: ' + (hasDC ? '✓ available (Digital Creds needs flag)' : '✗ not available'), hasDC ? 'll-y' : 'll-r');

  // Notifications
  const hasNotif = 'Notification' in window;
  const notifPerm = hasNotif ? Notification.permission : 'N/A';
  log(logId, 'Notifications: ' + (hasNotif ? '✓ API available, permission=' + notifPerm : '✗ not available'), hasNotif ? 'll-g' : 'll-r');
  document.getElementById('v3a-perm-val').textContent = notifPerm;

  // Fullscreen
  const hasFS = !!(document.documentElement.requestFullscreen);
  log(logId, 'Fullscreen API: ' + (hasFS ? '✓ available' : '✗ not available'), hasFS ? 'll-g' : 'll-r');
  document.getElementById('v3a-fs-val').textContent = hasFS ? 'available' : 'N/A';

  // getUserMedia
  const hasGUM = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
  log(logId, 'getUserMedia: ' + (hasGUM ? '✓ available' : '✗ not available'), hasGUM ? 'll-g' : 'll-r');

  // Geolocation
  const hasGeo = !!(navigator.geolocation);
  log(logId, 'Geolocation: ' + (hasGeo ? '✓ available' : '✗ not available'), hasGeo ? 'll-g' : 'll-r');

  // User Agent
  log(logId, 'UA: ' + navigator.userAgent.substring(0, 100), 'll-d');

  // Check Digital Credentials specifically
  checkDigitalCredsAPI();
}

// ─────────────────────────────────────────────
// V1 — WebAuthn Tests
// ─────────────────────────────────────────────
let createdCredId = null;

async function testWebAuthnBasic(targetRpId) {
  const logId = 'v1-log-basic';
  log(logId, 'Testing rpId: "' + targetRpId + '" from origin: ' + location.hostname, 'll-b');
  try {
    const result = await navigator.credentials.get({
      publicKey: {
        rpId: targetRpId,
        challenge: crypto.getRandomValues(new Uint8Array(32)),
        allowCredentials: [],
        userVerification: 'discouraged',
        timeout: 8000
      }
    });
    log(logId, 'SUCCESS — credential returned: ' + JSON.stringify(result?.type), 'll-g');
    setResult('v1-result-basic', '⚠ UNEXPECTED SUCCESS — credentials returned for rpId: ' + targetRpId, 'bypass');
  } catch(e) {
    log(logId, 'Error [' + e.name + ']: ' + e.message, e.name === 'SecurityError' ? 'll-r' : 'll-y');

    if (e.name === 'SecurityError') {
      log(logId, '→ Expected rejection. Chrome enforces rpId must be suffix of page domain.', 'll-g');
      setResult('v1-result-basic', '✓ Blocked — SecurityError (expected Chrome behavior). No UI shown.', 'patched');
    } else if (e.name === 'NotAllowedError') {
      log(logId, '→ NotAllowedError: UI may have appeared. Was there a dialog? What origin did it show?', 'll-y');
      setResult('v1-result-basic', '⚠ NotAllowedError — UI may have appeared. Screenshot origin label!', 'partial');
    } else if (e.name === 'AbortError') {
      log(logId, '→ User cancelled / timeout. Was UI shown? What origin did dialog display?', 'll-y');
      setResult('v1-result-basic', '⚠ Aborted — check if dialog appeared and what origin was shown', 'partial');
    }

    // VRP relevance
