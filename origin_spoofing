<title>Origin Spoof PoC Lab — VRP Research</title>
<style>
:root{
  --bg:#0d1117;--bg2:#161b22;--bg3:#21262d;--border:#30363d;
  --text:#c9d1d9;--dim:#8b949e;--blue:#58a6ff;--blue2:#79c0ff;
  --red:#ff7b72;--orange:#ffa657;--yellow:#e3b341;--green:#56d364;--purple:#bc8cff;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:14px;line-height:1.6}
h1{color:var(--blue2);font-size:19px;font-weight:800}
h2{color:var(--blue);font-size:14px;font-weight:700;margin-bottom:8px}
h3{color:var(--text);font-size:13px;font-weight:600;margin-bottom:6px}
code{background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:1px 6px;font-family:monospace;font-size:12px;color:var(--orange)}
pre{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:12px;font-size:12px;overflow-x:auto;line-height:1.8;white-space:pre-wrap}
a{color:var(--blue);text-decoration:none}

/* Layout */
.layout{display:flex;min-height:100vh}
.sidebar{width:240px;min-height:100vh;background:var(--bg2);border-right:1px solid var(--border);padding:16px 0;position:fixed;top:0;left:0;overflow-y:auto}
.main{margin-left:240px;padding:24px 32px;max-width:960px}

/* Sidebar */
.nav-brand{padding:0 14px 14px;border-bottom:1px solid var(--border);margin-bottom:10px}
.nav-brand .title{color:var(--blue2);font-weight:800;font-size:13px}
.nav-brand .sub{color:var(--dim);font-size:10px;margin-top:2px}
.nav-section{padding:10px 14px 3px;color:var(--dim);font-size:9px;text-transform:uppercase;letter-spacing:.8px}
.nav-item{display:block;padding:5px 14px;color:var(--dim);font-size:12px;border-left:2px solid transparent;transition:all .15s;cursor:pointer}
.nav-item:hover{color:var(--text);background:var(--bg3);border-left-color:var(--blue)}
.nav-item.active{color:var(--blue);border-left-color:var(--blue);background:var(--bg3)}

/* Cards */
.card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:18px 22px;margin-bottom:16px}
.card-hdr{display:flex;align-items:center;gap:10px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--border);flex-wrap:wrap}
.badge{background:var(--bg3);border:1px solid var(--border);border-radius:5px;padding:2px 9px;font-family:monospace;font-size:11px;font-weight:700;color:var(--blue)}
.rb{font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;white-space:nowrap}
.rb-r{background:#3d0000;color:var(--red)}
.rb-g{background:#0d2d00;color:var(--green)}
.rb-o{background:#2d1500;color:var(--orange)}
.rb-y{background:#2d2200;color:var(--yellow)}
.rb-p{background:#1a0a3d;color:var(--purple)}

/* Buttons */
.btn{padding:7px 14px;border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;background:var(--bg3);color:var(--text);transition:all .15s;font-family:inherit}
.btn:hover{border-color:var(--blue);color:var(--blue)}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn-r{background:#3d0000;border-color:var(--red);color:var(--red)}
.btn-r:hover{background:#5a0000}
.btn-g{background:#0d2d00;border-color:var(--green);color:var(--green)}
.btn-g:hover{background:#134000}
.btn-p{background:#1a0a3d;border-color:var(--purple);color:var(--purple)}
.btn-p:hover{background:#2a1050}
.btn-o{background:#2d1500;border-color:var(--orange);color:var(--orange)}
.btn-sm{padding:4px 10px;font-size:11px}
.bgroup{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}

/* Alerts */
.alert{border-radius:6px;padding:9px 13px;margin:8px 0;font-size:12px;line-height:1.6}
.a-r{background:#3d0000;border:1px solid #b91c1c;color:var(--red)}
.a-y{background:#2d2200;border:1px solid #9e6a03;color:var(--yellow)}
.a-b{background:#0c2a4a;border:1px solid #1f6feb;color:var(--blue2)}
.a-g{background:#0d2d00;border:1px solid #2ea043;color:var(--green)}
.a-p{background:#1a0a3d;border:1px solid #6e40c9;color:var(--purple)}

/* Log */
.log{background:#010409;border:1px solid var(--border);border-radius:5px;padding:8px 11px;font-family:monospace;font-size:11px;min-height:40px;max-height:160px;overflow-y:auto;margin-top:8px}
.ll-g{color:var(--green)}.ll-y{color:var(--yellow)}.ll-r{color:var(--red)}.ll-b{color:var(--blue)}.ll-d{color:var(--dim)}.ll-p{color:var(--purple)}

/* Tabs */
.tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:14px;flex-wrap:wrap}
.tab{padding:6px 14px;font-size:12px;cursor:pointer;color:var(--dim);border-bottom:2px solid transparent;margin-bottom:-1px;font-weight:600;transition:all .15s}
.tab:hover{color:var(--text)}
.tab.active{color:var(--blue);border-bottom-color:var(--blue)}
.tab-panel{display:none}
.tab-panel.active{display:block}

/* Status chips */
.chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.chip{padding:4px 12px;border-radius:20px;font-size:11px;font-family:monospace;border:1px solid var(--border);color:var(--dim);background:var(--bg3)}
.chip.ok{border-color:var(--green);color:var(--green)}
.chip.err{border-color:var(--red);color:var(--red)}
.chip.warn{border-color:var(--yellow);color:var(--yellow)}
.chip.info{border-color:var(--blue);color:var(--blue)}

/* Result banner */
.result-banner{display:none;padding:10px 16px;border-radius:6px;font-family:monospace;font-size:13px;font-weight:700;margin-top:10px;border:2px solid}
.result-banner.bypass{background:#0d2d00;border-color:var(--green);color:var(--green)}
.result-banner.patched{background:#3d0000;border-color:var(--red);color:var(--red)}
.result-banner.partial{background:#2d2200;border-color:var(--yellow);color:var(--yellow)}
.result-banner.pending{background:#0c2a4a;border-color:var(--blue);color:var(--blue)}

/* Grid */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}

/* Fullscreen fake UI */
#fs-overlay{display:none;position:fixed;inset:0;background:#f1f3f4;z-index:999999;flex-direction:column}
#fs-toolbar{background:#fff;border-bottom:1px solid #dadce0;height:52px;display:flex;align-items:center;padding:0 12px;gap:10px;box-shadow:0 1px 3px rgba(0,0,0,.1)}
#fs-urlbar{flex:1;background:#f1f3f4;border:1px solid #dadce0;border-radius:22px;padding:7px 16px;display:flex;align-items:center;gap:8px;font-size:14px}
#fs-content{flex:1;display:flex;align-items:center;justify-content:center;padding:40px;overflow:auto}
.perm-overlay{position:fixed;top:52px;left:50%;transform:translateX(-50%);background:#fff;border:1px solid #dadce0;border-radius:8px;padding:20px 24px;width:360px;box-shadow:0 4px 20px rgba(0,0,0,.15);z-index:9999999;display:none}
.perm-overlay h4{font-size:14px;color:#202124;margin-bottom:8px}
.perm-overlay p{font-size:13px;color:#5f6368;margin-bottom:14px}
.perm-overlay .origin{font-weight:700;color:#202124}
.perm-row{display:flex;gap:8px;justify-content:flex-end}
.perm-btn{padding:8px 18px;border-radius:4px;border:none;cursor:pointer;font-size:13px;font-weight:500}
.perm-allow{background:#1a73e8;color:#fff}
.perm-deny{background:transparent;color:#1a73e8}

.divider{border:none;border-top:1px solid var(--border);margin:20px 0}
.mono{font-family:monospace}
table{width:100%;border-collapse:collapse;font-size:12px}
th{background:var(--bg3);padding:7px 11px;text-align:left;color:var(--dim);font-weight:600;font-size:10px;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid var(--border)}
td{padding:7px 11px;border-bottom:1px solid var(--border);vertical-align:middle}
tr:last-child td{border-bottom:none}
</style>
