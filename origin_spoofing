    challenge: crypto.getRandomValues(new Uint8Array(32)),
    pubKeyCredParams: [{ type: "public-key", alg: -7 }]
  }
});

// Step 2: Get credential — observe picker UI</pre>
      <div class="bgroup">
        <button class="btn btn-p" onclick="createWebAuthnCred()">Step 1: Create Credential</button>
        <button class="btn btn-r" id="btn-get-cred" onclick="getWebAuthnCred()" disabled>Step 2: Get + Observe</button>
      </div>
      <div class="log" id="v1-log-create"><span class="ll-b">→ Step 1 dulu, lalu Step 2.</span></div>
    </div>
  </div>
</div>

<!-- ══════ V1b — Subdomain rpId ══════ -->
<div id="sec-v1b" class="section" style="display:none">
  <div class="card">
    <div class="card-hdr">
      <span class="badge" style="color:var(--blue)">V1b</span>
      <h2 style="margin-bottom:0">WebAuthn — Conditional Mediation (Autofill)</h2>
    </div>
    <div class="alert a-b">
      <strong>Conditional UI</strong> = passkey muncul di autofill dropdown input field (bukan popup modal).
      Ini lebih subtle dari modal — apakah origin label terlihat di autofill suggestion?
    </div>
    <pre>// Trigger conditional mediation — passkey di autofill
navigator.credentials.get({
  mediation: "conditional",
  publicKey: {
    challenge: crypto.getRandomValues(new Uint8Array(32)),
    allowCredentials: [],
    rpId: location.hostname
  }
});
// Lihat: apakah autofill suggestion menampilkan origin?
// Atau hanya username tanpa clear origin attribution?</pre>
    <div style="margin:12px 0">
      <input type="email" id="autofill-input" autocomplete="username webauthn"
        placeholder="Klik di sini — lalu lihat autofill suggestion"
        style="width:100%;padding:10px 14px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:14px;font-family:inherit;outline:none">
    </div>
